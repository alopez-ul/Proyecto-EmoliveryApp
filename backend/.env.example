# Copia este archivo como backend/.env
# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# true solo en desarrollo: muestra el enlace de recuperación en pantalla en vez de enviarlo por correo.
BUZON_SIMULADO=false
