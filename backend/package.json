{
  "name": "emoliente-tracker-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env --watch-path=src src/server.js",
    "start": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env src/migrate.js",
    "db:seed": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env src/seed.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "emoliente-tracker": "file:..",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
