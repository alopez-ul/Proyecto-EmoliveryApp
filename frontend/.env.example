# Opcional. Sin API key la web usa OpenStreetMap como mapa de respaldo.
# Copia este archivo como .env y coloca tu API key de Google Maps
# (Google Cloud Console > APIs y servicios > Credenciales; habilita "Maps JavaScript API")
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: Map ID propio para estilos personalizados. Si se omite se usa DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
